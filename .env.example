# Neon PostgreSQL connection string
# Create a project at https://neon.tech, copy the connection string from the Neon Console,
# and paste it below. Keep this file out of version control — copy to .env instead.
#
# Notes:
# - Use the pooler connection string for serverless / Prisma (Neon Dashboard → Connection Details)
# - Always include sslmode=require
# - Never hard-code credentials in source code
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# File storage (Cloudflare R2 recommended for Vercel deployments)
# ---------------------------------------------------------------------------
# Storage architecture:
#   Next.js → Server Actions/API → Storage abstraction → File Storage
#
# STORAGE_PROVIDER:
#   - "r2"    → Cloudflare R2 (S3-compatible) — use on Vercel / production
#   - "local" → local ./uploads directory — development only (ephemeral on Vercel)
# If unset, defaults to "r2" when R2_* vars are present, otherwise "local".
STORAGE_PROVIDER="r2"

# Cloudflare R2 (https://dash.cloudflare.com → R2 → Manage R2 API Tokens)
# Account ID: R2 dashboard → right sidebar
# Access key / secret: create an R2 API token with Object Read & Write
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="refdesk-uploads"
# Optional: public custom domain / public bucket URL (skips signed URLs)
# R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Optional: max upload size in bytes (default 10485760 = 10 MiB)
# MAX_FILE_SIZE_BYTES=10485760
