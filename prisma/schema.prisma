// refdesk — personal resource manager
//
// Schema is designed so additional resource types (PDF, PPTX, Excel, Note, Prompt)
// can be added later without breaking existing Link data.
//
// MVP: only ResourceType.LINK is used. Future types can reuse the shared Resource
// columns and add type-specific fields (fileKey, mime, note body, etc.) on this
// model or on dedicated side tables keyed by resource id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  LINK
  // Reserved for future resource types:
  // PDF
  // PPTX
  // EXCEL
  // NOTE
  // PROMPT
}

model Resource {
  id          String       @id @default(cuid())
  type        ResourceType @default(LINK)
  title       String
  /// Required for LINK resources. Reserved/null for future non-link types.
  url         String?
  description String?
  category    String?
  tags        String[]     @default([])
  favorite    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([category])
  @@index([favorite])
  @@index([createdAt])
}
