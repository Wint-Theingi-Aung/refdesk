// refdesk — personal resource manager
//
// Shared Resource model for all resource types.
// Existing LINK rows remain valid after enum/column expansion (nullable file fields).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  LINK
  PDF
  EXCEL
  PPTX
  DOCX
  IMAGE
}

model Resource {
  id          String       @id @default(cuid())
  type        ResourceType @default(LINK)
  title       String

  /// Link target (required for LINK; null for file types)
  url         String?

  /// File metadata (required for file types; null for LINK)
  fileName    String?
  /// Provider-specific object key (e.g. R2 key or local uploads path)
  storageKey  String?
  mimeType    String?
  /// Size in bytes
  fileSize    Int?

  description String?
  category    String?
  tags        String[]     @default([])
  favorite    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([category])
  @@index([favorite])
  @@index([createdAt])
  @@index([fileName])
}
